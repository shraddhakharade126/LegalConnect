# LegalConnect Environment Configuration
# Copy this file to .env and configure values

# MongoDB Connection String (MongoDB Atlas or local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://dbuser:securepassword@cluster0.example.mongodb.net/legalconnect?retryWrites=true&w=majority"

# JWT Secret for signing and verifying JSON Web Tokens (use a 256-bit secure secret in production)
JWT_SECRET="legalconnect_production_jwt_secret_key_change_in_prod_948271a"

# Optional Gemini API Key for client legal issue breakdown and pre-consultation question organizer
# AI Studio automatically injects this at runtime if configured in Secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Port for the server (defaults to 3000)
PORT=3000

# Environment mode: development or production
NODE_ENV="development"

# App URL for hosting
APP_URL="http://localhost:3000"
