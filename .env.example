# LegalConnect Environment Configuration
# Copy this file to .env and configure values

# MongoDB Connection String (MongoDB Atlas or local MongoDB instance)
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://dbuser:securepassword@cluster0.example.mongodb.net/legalconnect?retryWrites=true&w=majority"

# JWT Secret for signing and verifying JSON Web Tokens (use a 256-bit secure secret in production)
JWT_SECRET="legalconnect_production_jwt_secret_key_change_in_prod_948271a"

# Optional Gemini API Key for client legal issue breakdown and pre-consultation question organizer
# AI Studio automatically injects this at runtime if configured in Secrets
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Port for the server (defaults to 3000)
PORT=3000

# Environment mode: development or production
NODE_ENV="development"

# App URL for hosting
APP_URL="http://localhost:3000"

# Optional Client Firebase Config (for Vercel / Netlify deployment via GitHub)
# If left unset, LegalConnect automatically reads from firebase-applet-config.json
VITE_FIREBASE_API_KEY="AIzaSyDNcK7_O2l-P4bHMO3x3W0CNkDmtYELz-Y"
VITE_FIREBASE_PROJECT_ID="tangential-path-rxctm"
VITE_FIREBASE_AUTH_DOMAIN="tangential-path-rxctm.firebaseapp.com"
VITE_FIREBASE_STORAGE_BUCKET="tangential-path-rxctm.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="287076140885"
VITE_FIREBASE_APP_ID="1:287076140885:web:e8018a764fb6b1d2a551dc"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-legalconnectonli-4178a9d6-469f-44ce-9b9c-dedfdc90192d"
